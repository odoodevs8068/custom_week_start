<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="res_config_settings_view_form_inherit_group_by" model="ir.ui.view">
        <field name="name">res_config_settings_view_form_inherit_group_by</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="35"/>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name ='integration']" position="after">
                <h2>Configure Group By Week Start</h2>
                <div class="row mt16 o_settings_container" name="configure_group_by_week">
                    <div class="col-lg-6 col-12 o_setting_box" id="set_globally">
                        <div class="o_setting_left_pane">
                            <field name="set_globally"/>
                        </div>
                        <div class="o_setting_right_pane" id="set_globally">
                            <label for="set_globally"/>
                            <div class="text-muted">
                                Setting Globally Will Configure For All Models
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-6 col-12 o_setting_box" id="notify_user"
                         attrs="{'invisible' : [('set_globally', '=', True)] }">
                        <div class="o_setting_right_pane">
                            <label for="model_ids"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <field name="model_ids" widget="many2many_tags"/>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>